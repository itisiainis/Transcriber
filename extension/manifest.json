{
  "manifest_version": 3,
  "name": "Transcriber",
  "version": "0.1.0",
  "description": "YouTube-video-to-transcript-to-Claude-analysis, from a side panel.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "nativeMessaging", "tabs", "scripting", "notifications", "storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Transcriber",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
